# ==============================================================================
# Scientific Agentic RAG Environment Configuration
# Copy this file to '.env' and populate your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Groq)
# Required for reasoning, synthesis, gap detection, and report generation.
# Get your free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection
# Options:
#   - openai/gpt-oss-120b (Recommended default)
#   - llama-3.3-70b-versatile
#   - llama-3.1-8b-instant (Fast / Low Latency)
#   - mixtral-8x7b-32768
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Vector Database Configuration (ChromaDB)
# Local directory where Chroma stores vectorized scientific paper collections.
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db

# ------------------------------------------------------------------------------
# Server Configuration (Optional defaults)
# ------------------------------------------------------------------------------
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
